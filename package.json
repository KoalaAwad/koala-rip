{
  "name": "gaming-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "rm -rf node_modules/.astro .astro && astro build",
    "preview": "astro preview",
    "fetch:opencritic": "node scripts/fetch-opencritic.mjs",
    "sync:steam": "node --env-file=.env scripts/sync-steam.mjs",
    "fetch:covers": "node --env-file=.env scripts/fetch-covers.mjs",
    "sync:psn": "node --env-file=.env scripts/sync-psn.mjs",
    "sync": "npm run sync:steam && npm run sync:psn"
  },
  "dependencies": {
    "astro": "^5.18.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "psn-api": "^2.18.1",
    "simple-icons": "^15.22.0"
  }
}
