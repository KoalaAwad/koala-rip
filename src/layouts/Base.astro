---
import "../styles/global.css";

interface Props { title?: string; description?: string }
const {
  title = "koala.rip · Awad's gaming log",
  description = "Every trophy I've earned on Steam and PlayStation, the games I play each year ranked out of ten, and the odd review.",
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/koala.png" />
    <link rel="preconnect" href="https://api.fontshare.com" />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=erode@400,500,600&display=swap" />
  </head>
  <body>
    <slot />

    <script>
      import Lenis from "lenis";
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      gsap.registerPlugin(ScrollTrigger);
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (!reduce) {
        const lenis = new Lenis({ lerp: 0.09 });
        lenis.on("scroll", ScrollTrigger.update);
        gsap.ticker.add((t) => lenis.raf(t * 1000));
        gsap.ticker.lagSmoothing(0);

        // Entrance for the parts of every section: heading, then text, then pictures, staggered.
        // Content is visible without script; GSAP only animates *from* an offset once the section arrives.
        gsap.utils.toArray<HTMLElement>("[data-enter]").forEach((section) => {
          const parts = section.querySelectorAll("[data-part]");
          if (!parts.length) return;
          gsap.from(parts, {
            y: 24, opacity: 0, duration: 0.9, ease: "power3.out", stagger: 0.075,
            scrollTrigger: { trigger: section, start: "top 85%", once: true },
          });
        });
      }
    </script>
  </body>
</html>
