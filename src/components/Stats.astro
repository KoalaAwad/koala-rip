---
import { profile, fmtDate } from "../lib/data";

const s = profile.stats;
---
<section class="intro" id="trophies" data-reveal>
  <p>Just a place to keep my achievements, rank the games I play each year, and every now and then ramble about one in a review.</p>
  <div class="cols">
    <div class="col">
      <span class="label">PlayStation platinums</span>
      <span class="v">{s.platinums}</span>
      <p>Latest: {s.latestPlatinum.title}, {fmtDate(s.latestPlatinum.date)}</p>
    </div>
    <div class="col">
      <span class="label">Steam achievements</span>
      <span class="v">{s.steamAchievements.toLocaleString("en-US")}</span>
      <p>{s.perfectGames} {s.perfectGames === 1 ? "game" : "games"} at 100%</p>
    </div>
  </div>
</section>

<style>
  .intro { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: start; }
  .intro > p {
    margin: 0; font-family: var(--display); font-weight: 300;
    font-size: clamp(20px, 2.2vw, 26px); line-height: 1.25; letter-spacing: -.01em; max-width: 32ch;
  }
  .cols { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .col { border-top: 1px solid var(--line-strong); padding-top: 10px; display: grid; gap: 4px; align-content: start; min-width: 0; }
  .v { font-family: var(--display); font-weight: 800; font-size: clamp(36px, 4vw, 52px); line-height: 1; font-variant-numeric: tabular-nums; letter-spacing: -.02em; }
  .col p { margin: 0; color: var(--dim); font-size: 12px; }
  @media (max-width: 820px) {
    .intro { grid-template-columns: 1fr; }
  }
</style>
