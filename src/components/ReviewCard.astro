---
import type { CollectionEntry } from "astro:content";
import { heroArtFor, fmtDate } from "../lib/data";

interface Props { review: CollectionEntry<"reviews"> }
const { review } = Astro.props;
const { game, score, date, excerpt } = review.data;
const art = heroArtFor(game);
---
<a class="card" href={`/reviews/${review.id}/`}>
  <div class="thumb">
    {art && <img src={art} alt="" loading="lazy" decoding="async" />}
    <span class="score">{score}</span>
  </div>
  <span class="label">{fmtDate(date)}</span>
  <h3>{game}</h3>
  <p>{excerpt}</p>
</a>

<style>
  .card { display: grid; gap: 8px; color: inherit; text-decoration: none; min-width: 0; }
  .thumb { aspect-ratio: 2.39 / 1; position: relative; overflow: hidden; background: linear-gradient(150deg, #1b2148, var(--bg) 75%); }
  .thumb img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: .65; transition: transform 1.2s var(--ease-out), opacity .6s; }
  .thumb::after { content: ""; position: absolute; inset: 0; border-top: 9px solid #000; border-bottom: 9px solid #000; transition: border-width .5s var(--ease-cut); }
  .card:hover .thumb img { transform: scale(1.06); opacity: .85; }
  .card:hover .thumb::after { border-width: 0; }
  .score { position: absolute; right: 10px; bottom: 14px; z-index: 1; font-family: var(--display); font-weight: 800; font-size: 28px; letter-spacing: -.03em; }
  h3 { margin: 0; font-family: var(--display); font-weight: 500; font-size: 19px; letter-spacing: -.01em; }
  p { margin: 0; color: var(--dim); font-size: 12px; max-width: 40ch; }
</style>
