---
// One platform's list: its icon and name, then every game with a cover, a progress bar and the percentage.
import PlatformIcon from "./PlatformIcon.astro";
import type { ProgressRow } from "../lib/data";
import { optimizeFirst } from "../lib/img";

interface Props {
  platform: "steam" | "psn";
  title: string;
  profileUrl?: string;
  idLabel?: string; // shown instead of a profile link (e.g. the PSN ID)
  rows: ProgressRow[];
  completeWord: string; // "platinum" or "100%"
  emptyText: string;
}
const { platform, title, profileUrl, idLabel, rows, completeWord, emptyText } = Astro.props;
// 40px WebP thumbnails; falls back to the Steam header, then the placeholder.
const covers = await Promise.all(rows.map((r) => optimizeFirst([r.cover, r.fallback], 40)));
const completed = rows.filter((r) => r.complete).length;
const summary = platform === "psn"
  ? `${completed} ${completed === 1 ? "platinum" : "platinums"} from ${rows.length} games`
  : `${completed} at 100% from ${rows.length} games`;
---
<section class:list={["window", platform]} aria-labelledby={`${platform}-h`}>
  <header class="bar">
    <h2 id={`${platform}-h`}><PlatformIcon platform={platform} size={22} /> {title}</h2>
    <p>{rows.length > 0 && <>{summary}. </>}{profileUrl ? <a href={profileUrl} target="_blank" rel="noopener">Profile</a> : idLabel && <span class="id">{idLabel}</span>}</p>
  </header>

  {rows.length > 0 ? (
    <ol class="rows">
      {rows.map((r, i) => (
        <li class:list={[{ complete: r.complete }]}>
          <span class="cov art-slot">
            {covers[i] && <img src={covers[i]!.src} srcset={covers[i]!.srcset} alt="" loading="lazy" decoding="async" width="40" height="60" />}
          </span>
          <span class="main">
            <span class="name">{r.title}</span>
            <span class="track" role="progressbar" aria-valuenow={r.percent} aria-valuemin="0" aria-valuemax="100" aria-label={`${r.earned} of ${r.total}`}>
              <span class="fill" style={`width:${r.percent}%`}></span>
            </span>
            <span class="count">{r.earned} of {r.total}{r.complete && <span class="done">, {completeWord}</span>}</span>
          </span>
          <span class="pct num">{r.percent}%</span>
        </li>
      ))}
    </ol>
  ) : (
    <p class="empty">{emptyText}</p>
  )}
</section>

<style>
  .window { background: var(--bg-raise); display: grid; grid-template-rows: auto 1fr; min-width: 0; }
  .bar { display: flex; justify-content: space-between; align-items: baseline; gap: 8px 16px; flex-wrap: wrap; padding: 20px 24px; background: var(--bg-raise-2); }
  h2 { display: flex; align-items: center; gap: 12px; margin: 0; font-family: var(--display); font-size: 22px; font-weight: 800; }
  .steam h2 :global(svg) { color: var(--steam-pos); }
  .psn h2 :global(svg) { color: #6aa8ff; }
  .bar p { margin: 0; color: var(--dim); font-size: 12px; }
  .bar a { text-underline-offset: 3px; color: var(--fg); }

  .rows { list-style: none; margin: 0; padding: 8px 24px 16px; }
  .count { color: var(--dim); font-size: 12px; }
  li { display: grid; grid-template-columns: 40px 1fr auto; gap: 16px; align-items: center; padding: 12px 0; }
  .cov { width: 40px; height: 60px; overflow: hidden; }
  .id { color: var(--fg); user-select: all; }
  .cov img { width: 100%; height: 100%; object-fit: cover; }
  .main { display: grid; gap: 6px; min-width: 0; }
  .name { font-family: var(--display); font-weight: 500; font-size: 17px; line-height: 1.2; overflow-wrap: anywhere; }
  .track { height: 6px; background: var(--bg); overflow: hidden; }
  .fill { display: block; height: 100%; background: var(--fg); transform-origin: left; animation: grow .9s var(--ease-out) both; }
  li.complete .fill { background: var(--gold); }
  .done { color: var(--gold); }
  .pct { font-family: var(--display); font-size: 20px; font-weight: 800; min-width: 64px; text-align: right; font-variant-numeric: tabular-nums; }
  li.complete .pct { color: var(--gold); }
  .empty { padding: 32px 24px; }
  @media (max-width: 600px) {
    .bar { padding: 16px 12px; }
    .rows { padding: 4px 12px 12px; }
    li { gap: 12px; }
    .pct { min-width: 52px; }
  }
  @keyframes grow { from { transform: scaleX(0.2); } }
</style>
