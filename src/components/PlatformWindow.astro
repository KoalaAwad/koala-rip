---
// One platform's list: its icon and name, then every game with a cover, a progress bar and the percentage.
import PlatformIcon from "./PlatformIcon.astro";
import type { ProgressRow } from "../lib/data";

interface Props {
  platform: "steam" | "psn";
  title: string;
  profileUrl: string;
  rows: ProgressRow[];
  completeWord: string; // "platinum" or "100%"
  emptyText: string;
}
const { platform, title, profileUrl, rows, completeWord, emptyText } = Astro.props;
const completed = rows.filter((r) => r.complete).length;
const summary = platform === "psn"
  ? `${completed} ${completed === 1 ? "platinum" : "platinums"} from ${rows.length} games`
  : `${completed} at 100% from ${rows.length} games`;
---
<section class:list={["window", platform]} aria-labelledby={`${platform}-h`} data-enter>
  <header class="bar" data-part>
    <h2 id={`${platform}-h`}><PlatformIcon platform={platform} size={22} /> {title}</h2>
    <p>{rows.length > 0 && <>{summary}. </>}<a href={profileUrl} target="_blank" rel="noopener">Profile</a></p>
  </header>

  {rows.length > 0 ? (
    <ol class="rows">
      {rows.map((r) => (
        <li class:list={[{ complete: r.complete }]}>
          <span class="cov">
            {r.cover && (
              <img
                src={r.cover}
                alt=""
                loading="lazy"
                decoding="async"
                width="40"
                height="60"
                data-fallback={r.fallback ?? undefined}
                onerror="if(this.dataset.fallback&&this.src!==this.dataset.fallback){this.src=this.dataset.fallback}else{this.remove()}"
              />
            )}
          </span>
          <span class="main">
            <span class="name">{r.title}</span>
            <span class="track" role="progressbar" aria-valuenow={r.percent} aria-valuemin="0" aria-valuemax="100" aria-label={`${r.earned} of ${r.total}`}>
              <span class="fill" style={`width:${r.percent}%`}></span>
            </span>
            <span class="count">{r.earned} of {r.total}{r.complete && <span class="done">, {completeWord}</span>}</span>
          </span>
          <span class="pct num">{r.percent}%</span>
        </li>
      ))}
    </ol>
  ) : (
    <p class="empty">{emptyText}</p>
  )}
</section>

<style>
  .window { background: var(--surface); display: grid; grid-template-rows: auto 1fr; min-width: 0; }
  .bar { display: flex; justify-content: space-between; align-items: baseline; gap: 8px 16px; flex-wrap: wrap; padding: 20px 24px; background: var(--surface-2); }
  h2 { display: flex; align-items: center; gap: 12px; font-size: var(--step-lead); font-weight: 600; }
  .steam h2 :global(svg) { color: var(--steam-pos); }
  .psn h2 :global(svg) { color: #6aa8ff; }
  .bar a { text-underline-offset: 3px; }

  .rows { list-style: none; margin: 0; padding: 8px 24px 16px; }
  .count { color: var(--ink); }
  li { display: grid; grid-template-columns: 40px 1fr auto; gap: 16px; align-items: center; padding: 12px 0; }
  .cov { width: 40px; height: 60px; overflow: hidden; background: var(--bg); }
  .cov img { width: 100%; height: 100%; object-fit: cover; }
  .main { display: grid; gap: 6px; min-width: 0; }
  .name { line-height: 1.2; overflow-wrap: anywhere; }
  .track { height: 6px; background: var(--bg); overflow: hidden; }
  .fill { display: block; height: 100%; background: var(--ink); transform-origin: left; animation: grow .9s var(--ease-out) both; }
  li.complete .fill { background: var(--gold); }
  .done { color: var(--gold); }
  .pct { font-size: var(--step-lead); font-weight: 600; min-width: 64px; text-align: right; }
  li.complete .pct { color: var(--gold); }
  .empty { padding: 32px 24px; }
  @media (max-width: 600px) {
    .bar { padding: 16px 12px; }
    .rows { padding: 4px 12px 12px; }
    li { gap: 12px; }
    .pct { min-width: 52px; }
  }
  @keyframes grow { from { transform: scaleX(0.2); } }
</style>
