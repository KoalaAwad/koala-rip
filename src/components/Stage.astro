---
// The fixed half: one game's art, edge to edge, that swaps to whichever game the reader is on.
// Any element with data-stage="<image url>" and data-stage-title="<name>" drives it (scroll into the middle, hover or focus).
interface Props { src: string | null; title: string }
const { src, title } = Astro.props;
---
<aside class="stage" aria-label="Game art">
  <div class="frame">
    {src && <img class="pic on" src={src} alt={title} fetchpriority="high" />}
    <img class="pic" alt="" aria-hidden="true" />
  </div>
  <p class="caption" aria-live="polite">{title}</p>
</aside>

<style>
  .stage {
    position: sticky; top: 0; height: 100svh;
    padding: 20px 0 20px 20px;
    display: grid; grid-template-rows: 1fr auto; gap: 10px;
  }
  .frame { position: relative; overflow: hidden; background: var(--surface); min-height: 0; }
  .pic {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    opacity: 0; transition: opacity .6s var(--ease-out);
  }
  .pic.on { opacity: 1; animation: drift 24s ease-in-out infinite alternate; }
  @keyframes drift { from { transform: scale(1.02); } to { transform: scale(1.09) translate(-1.5%, -1%); } }
  .caption { font-size: var(--step-small); color: var(--muted); }

  @media (max-width: 900px) {
    .stage { position: relative; height: 58svh; padding: 12px 12px 0; grid-template-rows: 1fr; }
    .caption { display: none; } /* not sticky on a phone, so it never swaps; the epitaph names the game */
  }
</style>

<script>
  const stage = document.querySelector<HTMLElement>(".stage");
  // Only where the stage is sticky (side by side with the reading column) does swapping make sense.
  if (stage && matchMedia("(min-width: 901px)").matches) {
    const pics = stage.querySelectorAll<HTMLImageElement>(".pic");
    const caption = stage.querySelector<HTMLElement>(".caption")!;
    let front = 0;
    let current = pics[0]?.getAttribute("src") ?? "";

    const show = (src: string | undefined, title: string | undefined) => {
      if (!src || src === current) return;
      current = src;
      const next = pics[1 - front];
      const img = new Image();
      img.onload = () => {
        if (current !== src) return; // a newer request won
        next.src = src;
        next.alt = title ?? "";
        next.classList.add("on");
        pics[front].classList.remove("on");
        front = 1 - front;
        caption.textContent = title ?? "";
      };
      img.src = src;
    };

    const drivers = document.querySelectorAll<HTMLElement>("[data-stage]");
    drivers.forEach((el) => {
      const go = () => show(el.dataset.stage, el.dataset.stageTitle);
      el.addEventListener("mouseenter", go);
      el.addEventListener("focusin", go);
    });

    // Whatever crosses the middle of the screen takes the stage.
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        if (e.isIntersecting) {
          const el = e.target as HTMLElement;
          show(el.dataset.stage, el.dataset.stageTitle);
        }
      }),
      { rootMargin: "-45% 0px -45% 0px" },
    );
    drivers.forEach((el) => io.observe(el));
  }
</script>
