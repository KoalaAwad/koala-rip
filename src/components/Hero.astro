---
// Banner: the most recent completion across platforms (Steam 100% or PlayStation platinum),
// in a letterboxed 2.39:1 frame over the game's key art, with drifting light.
import { latestCompletion, heroArtFor, steamArt, displayTitle, fmtDate } from "../lib/data";

const raw = latestCompletion();
const c = raw && { ...raw, title: displayTitle(raw.title) }; // your spelling from the rankings, not Steam's "DAVE THE DIVER"
const isSteam = c?.platform === "Steam";
const art = !c ? null : c.hero ?? (c.appid ? steamArt(c.appid, "hero") : heroArtFor(c.title));
const kind = isSteam ? "Latest 100%" : "Latest platinum";
const unit = isSteam ? "achievements" : "trophies";
---
{c && (
  <section class="feature" aria-label={`${kind}: ${c.title}`}>
    {art && <img class="art" src={art} alt="" fetchpriority="high" />}
    <div class="glow g1" aria-hidden="true"></div>
    <div class="glow g2" aria-hidden="true"></div>
    <div class="flare" aria-hidden="true"></div>
    <div class="grain" aria-hidden="true"></div>
    <div class="bars" aria-hidden="true"></div>

    <div class="status">
      <svg viewBox="0 0 64 64" aria-hidden="true"><path d="M14 4h36v6h10v8c0 10-7 16-14 17-3 6-7 9-10 10v7h10v8H18v-8h10v-7c-3-1-7-4-10-10C11 34 4 28 4 18v-8h10z" /></svg>
      <span>{kind} · {c.platform}</span>
    </div>
    <div class="date">{fmtDate(c.date)}</div>

    <div class="t">
      <h1>{c.title}</h1>
      <div class="meta">
        <span><b>{c.earned} / {c.total}</b>{" "}{unit}</span>
        {c.hours !== null && <span><b>{c.hours}h</b> played</span>}
      </div>
    </div>
  </section>
)}

<style>
  .feature {
    --bars: 9%;
    position: relative;
    aspect-ratio: 2.39 / 1;
    width: 100%;
    overflow: hidden;
    isolation: isolate;
    background: linear-gradient(160deg, #1b2148, #070a17 72%);
  }
  .art {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; z-index: -3; opacity: .85;
    animation: kb 30s ease-in-out infinite alternate;
  }
  /* Darken only where text sits (top labels, bottom-left title) so white text stays readable even on very light art */
  .feature::after {
    content: ""; position: absolute; inset: 0; z-index: -2; pointer-events: none;
    background:
      linear-gradient(180deg, rgba(5, 7, 16, .9) 0%, rgba(5, 7, 16, .55) 18%, transparent 36%),
      linear-gradient(0deg, rgba(5, 7, 16, .88) 0%, rgba(5, 7, 16, .35) 45%, transparent 70%),
      linear-gradient(90deg, rgba(5, 7, 16, .45) 0%, transparent 55%);
  }
  .glow { position: absolute; border-radius: 50%; filter: blur(40px); mix-blend-mode: screen; z-index: -1; will-change: transform; }
  .g1 { z-index: -3; width: 60%; height: 120%; left: 45%; top: -35%; background: radial-gradient(closest-side, var(--star), transparent); opacity: .55; animation: drift1 18s ease-in-out infinite alternate; }
  .g2 { width: 45%; height: 90%; left: -5%; top: 30%; background: radial-gradient(closest-side, var(--nebula-a), transparent); opacity: .35; animation: drift2 23s ease-in-out infinite alternate; }
  .flare { position: absolute; inset: -20%; z-index: -1; background: linear-gradient(105deg, transparent 42%, rgba(255, 245, 225, .10) 48%, rgba(255, 245, 225, .02) 52%, transparent 58%); animation: flare 11s ease-in-out infinite; }
  .grain {
    position: absolute; inset: 0; z-index: -1; opacity: .12; mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
    animation: grain .6s steps(3) infinite;
  }
  .bars::before, .bars::after {
    content: ""; position: absolute; left: 0; right: 0; height: var(--bars); background: #000; z-index: 2;
    animation: open 1.6s var(--ease-cut) .2s both;
  }
  .bars::before { top: 0; }
  .bars::after { bottom: 0; }

  .status, .date {
    position: absolute; top: calc(var(--bars) + 18px); z-index: 3;
    font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: rgba(238, 240, 248, .95);
    text-shadow: 0 1px 2px rgba(0, 0, 0, .8), 0 0 12px rgba(0, 0, 0, .55);
  }
  .status { left: clamp(16px, 3vw, 32px); display: flex; align-items: center; gap: 8px; }
  .status svg { width: 12px; height: 12px; fill: var(--gold); }
  .date { right: clamp(16px, 3vw, 32px); font-variant-numeric: tabular-nums; }

  .t {
    position: absolute; z-index: 3;
    left: clamp(16px, 3vw, 32px); right: clamp(16px, 3vw, 32px); bottom: calc(var(--bars) + 20px);
    display: grid; gap: 12px;
    text-shadow: 0 1px 3px rgba(0, 0, 0, .7), 0 0 18px rgba(0, 0, 0, .45);
    animation: rise 1.2s var(--ease-out) .9s both;
  }
  h1 {
    margin: 0; font-family: var(--display); font-weight: 800;
    font-size: clamp(32px, 6.4vw, 92px); line-height: .88; letter-spacing: -.045em;
    text-wrap: balance; max-width: 14ch;
  }
  .meta { display: flex; flex-wrap: wrap; gap: 6px 22px; font-size: 12px; letter-spacing: .05em; text-transform: uppercase; color: rgba(238, 240, 248, .88); }
  .meta b { color: var(--fg); font-weight: 500; }

  @keyframes kb { from { transform: scale(1.02); } to { transform: scale(1.12) translate(-2%, 1%); } }
  @keyframes drift1 { 0% { transform: translate(0, 0) scale(1); } 50% { transform: translate(-14%, 10%) scale(1.12); } 100% { transform: translate(-26%, 4%) scale(.95); } }
  @keyframes drift2 { 0% { transform: translate(0, 0); } 100% { transform: translate(30%, -18%) scale(1.15); } }
  @keyframes flare { 0%, 100% { transform: translateX(-18%); } 50% { transform: translateX(18%); } }
  @keyframes grain { 0% { transform: translate(0, 0); } 33% { transform: translate(-3%, 2%); } 66% { transform: translate(2%, -3%); } }
  @keyframes open { from { height: 50%; } to { height: var(--bars); } }
  @keyframes rise { from { opacity: .001; transform: translateY(14px); } to { opacity: 1; transform: none; } }

  @media (max-width: 820px) {
    .feature { aspect-ratio: 4 / 5; --bars: 6%; }
  }
</style>
