---
import { getImage } from "astro:assets";
import koalaSrc from "../assets/koala.png";
const koala = await getImage({ src: koalaSrc, width: 90, densities: [1, 2], format: "webp" });
// The koala from koalaawad.github.io, with the same five-sparkle burst on hover.
const sparkle = "M93.781 51.578C95 50.969 96 49.359 96 48c0-1.375-1-2.969-2.219-3.578 0 0-22.868-1.514-31.781-10.422-8.915-8.91-10.438-31.781-10.438-31.781C50.969 1 49.375 0 48 0s-2.969 1-3.594 2.219c0 0-1.5 22.87-10.406 31.781-8.908 8.913-31.781 10.422-31.781 10.422C1 45.031 0 46.625 0 48c0 1.359 1 2.969 2.219 3.578 0 0 22.873 1.51 31.781 10.422 8.906 8.911 10.406 31.781 10.406 31.781C45.031 95 46.625 96 48 96s2.969-1 3.562-2.219c0 0 1.523-22.871 10.438-31.781 8.913-8.908 31.781-10.422 31.781-10.422Z";
---
<a href="/" class="koala" aria-label="Home">
  {[1, 2, 3, 4, 5].map(() => (
    <svg viewBox="0 0 96 96" aria-hidden="true"><path d={sparkle} /></svg>
  ))}
  <img src={koala.src} srcset={koala.srcSet.attribute} alt="" width="90" height="90" />
</a>

<style>
  /* Same proportions as the portfolio: 90px koala, 0.5rem padding, 20px sparkles (45px on phones). */
  .koala {
    --glare: rgba(150, 132, 255, .85);
    position: relative;
    display: inline-block;
    padding: .5rem;
    border-radius: 1rem;
    transition: background .2s;
  }
  .koala:hover { background: rgba(90, 63, 214, .14); }
  img {
    display: block;
    width: 90px;
    height: 90px;
    transition: transform .2s, filter .2s;
    filter: drop-shadow(0 0 0 transparent);
  }
  .koala:hover img { transform: translateY(-3px) scale(1.05); filter: drop-shadow(0 10px 20px rgba(90, 63, 214, .45)); }
  .koala:active img { transform: none; }

  svg {
    position: absolute;
    z-index: 3;
    width: 20px;
    height: 20px;
    top: calc(var(--y) * 1%);
    left: calc(var(--x) * 1%);
    transform: translate(-50%, -50%) scale(0);
    pointer-events: none;
    fill: var(--glare);
  }
  .koala:hover svg { animation: sparkle .75s calc(var(--d) * .15s) both; }
  @keyframes sparkle { 50% { transform: translate(-50%, -50%) scale(var(--s)); } }

  svg:nth-of-type(1) { --x: 0;   --y: 20; --s: 1.1;  --d: 1; }
  svg:nth-of-type(2) { --x: 15;  --y: 80; --s: 1.25; --d: 2; }
  svg:nth-of-type(3) { --x: 45;  --y: 40; --s: 1.1;  --d: 3; }
  svg:nth-of-type(4) { --x: 75;  --y: 60; --s: .9;   --d: 2; }
  svg:nth-of-type(5) { --x: 100; --y: 30; --s: .8;   --d: 4; }

  @media (max-width: 820px) {
    img { width: 45px; height: 45px; }
    svg { display: none; }
  }
</style>
