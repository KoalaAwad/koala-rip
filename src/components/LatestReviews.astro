---
import { getCollection } from "astro:content";
import ReviewCard from "./ReviewCard.astro";

const latest = (await getCollection("reviews", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---
<section class="reviews" id="reviews" data-reveal>
  <header>
    <h2 class="section-title">Latest reviews</h2>
    {latest.length > 0 && <a href="/reviews/">All reviews →</a>}
  </header>
  {latest.length > 0 ? (
    <div class="cards">{latest.map((r) => <ReviewCard review={r} />)}</div>
  ) : (
    <div class="empty">
      <p>No written reviews yet. The first one will appear here, and its score in the rankings will link to it.</p>
    </div>
  )}
</section>

<style>
  .reviews { display: grid; gap: 16px; }
  header { display: flex; justify-content: space-between; align-items: baseline; border-top: 1px solid var(--line); padding-top: 24px; }
  header a { color: var(--dim); font-size: 11px; text-transform: uppercase; letter-spacing: .08em; text-decoration: none; }
  header a:hover { color: var(--fg); }
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .empty { border: 1px dashed var(--line); padding: 28px; }
  .empty p { margin: 0; color: var(--dim); max-width: 60ch; }
  @media (max-width: 820px) { .cards { grid-template-columns: 1fr; } }
</style>
