---
import { profile } from "../lib/data";

const sources = (profile as { sources?: { steam?: boolean; psn?: boolean } }).sources ?? {};
const pending = [!sources.psn && "PlayStation trophy stats", !sources.steam && "Steam stats"].filter(Boolean);
---
<footer>
  <span>© {new Date().getFullYear()} {profile.name}</span>
  <span>
    Game data from Steam{pending.length ? ` · ${pending.join(" and ")} are placeholders for now` : ""}
  </span>
</footer>

<style>
  footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    color: var(--dim);
    font-size: 11px;
    border-top: 1px solid var(--line);
    padding-top: 16px;
  }
</style>
