---
import { getCollection } from "astro:content";
import { rankings, years, gameInfo, coverFor, sentiment, critic } from "../lib/data";

// A score links to a review when the entry has an explicit `review` URL or a published review exists for that game.
const reviews = await getCollection("reviews", ({ data }) => !data.draft);
const reviewUrl = (title: string, explicit: string | null) =>
  explicit ?? (reviews.find((r) => r.data.game === title) ? `/reviews/${reviews.find((r) => r.data.game === title)!.id}/` : null);
---
<section class="rank" id="ranked">
  <div class="side" data-reveal>
    <h2 class="section-title">The year,<br />ranked</h2>
    <div class="years" role="tablist" aria-label="Year">
      {years.map((y, i) => (
        <button type="button" role="tab" id={`tab-${y}`} aria-controls={`list-${y}`} aria-selected={i === 0 ? "true" : "false"} data-year={y}>{y}</button>
      ))}
    </div>
    <p class="legend">Underlined scores link to a written review.</p>
  </div>

  <div class="lists">
    {years.map((y, i) => (
      <ol class="list" id={`list-${y}`} role="tabpanel" aria-labelledby={`tab-${y}`} hidden={i !== 0}>
        {rankings[y].map((e, idx) => {
          const g = gameInfo(e.title);
          const cover = coverFor(e.title);
          const c = critic(g);
          const href = reviewUrl(e.title, e.review);
          return (
            <li class:list={[{ top: e.score === 10 }]}>
              <span class="n">{String(idx + 1).padStart(2, "0")}</span>
              <span class="cov">{cover ? <img src={cover} alt="" loading="lazy" decoding="async" /> : null}</span>
              <span class="info">
                <span class="g">{e.title}</span>
                <span class="sub">
                  {g.appid
                    ? <span class:list={["steam", sentiment(g.reviewDesc)]} title={g.reviewTotal ? `${g.reviewPct}% of ${g.reviewTotal.toLocaleString("en-US")} Steam reviews` : undefined}>{g.reviewDesc ?? "No Steam reviews yet"}</span>
                    : <span>Not on Steam</span>}
                  {c && <span class="critic">{c.source} <b>{c.score}</b></span>}
                </span>
              </span>
              {href
                ? <a class="s linked" href={href} aria-label={`${e.score} out of 10, read the review`}>{e.score}<small>/10</small></a>
                : <span class="s">{e.score}<small>/10</small></span>}
            </li>
          );
        })}
      </ol>
    ))}
  </div>
</section>

<script>
  import { gsap } from "gsap";
  const tabs = document.querySelectorAll<HTMLButtonElement>(".years [role=tab]");
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  tabs.forEach((tab) =>
    tab.addEventListener("click", () => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute("aria-selected", String(on));
        document.getElementById(t.getAttribute("aria-controls")!)!.hidden = !on;
      });
      if (!reduce) {
        const rows = document.querySelectorAll(`#${tab.getAttribute("aria-controls")} li`);
        gsap.fromTo(rows, { opacity: 0, y: 10 }, { opacity: 1, y: 0, duration: .5, stagger: .025, ease: "power2.out" });
      }
    }),
  );
</script>

<style>
  .rank { display: grid; grid-template-columns: 1fr 2fr; gap: 32px; border-top: 1px solid var(--line); padding-top: 24px; }
  .side { align-self: start; position: sticky; top: calc(env(safe-area-inset-top, 0px) + 24px); }
  .years { display: flex; gap: 6px; margin-top: 14px; }
  .years button {
    font: inherit; font-size: 11px; color: var(--dim); background: none;
    border: 1px solid var(--line); padding: 5px 12px; border-radius: 999px; cursor: pointer;
    transition: color .2s, background .2s, border-color .2s;
  }
  .years button:hover { color: var(--fg); }
  .years button[aria-selected="true"] { color: var(--bg); background: var(--fg); border-color: var(--fg); }
  .legend { margin: 16px 0 0; color: var(--dim); font-size: 11px; max-width: 30ch; }

  .list { list-style: none; margin: 0; padding: 0; min-width: 0; }
  .list li {
    display: grid; grid-template-columns: 40px 44px 1fr auto; gap: 16px; align-items: center;
    padding: 10px 0; border-bottom: 1px solid var(--line); transition: padding .3s ease;
  }
  .list li:hover { padding-left: 8px; }
  .n { font-family: var(--display); font-weight: 500; font-size: 20px; color: var(--dim); font-variant-numeric: tabular-nums; }
  .cov { width: 44px; height: 66px; border-radius: 2px; overflow: hidden; background: linear-gradient(160deg, var(--bg-raise), var(--line)); }
  .cov img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s var(--ease-out); }
  .list li:hover .cov img { transform: scale(1.08); }
  .info { display: grid; gap: 4px; min-width: 0; }
  .g { font-family: var(--display); font-size: clamp(18px, 2vw, 24px); letter-spacing: -.015em; line-height: 1.1; }
  .sub { display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: 11px; color: var(--dim); }
  .critic { border: 1px solid var(--line); padding: 0 5px; border-radius: 2px; font-variant-numeric: tabular-nums; }
  .critic b { color: var(--fg); font-weight: 500; }
  .s {
    font-family: var(--display); font-weight: 800; font-size: 24px; letter-spacing: -.02em;
    text-align: right; min-width: 64px; font-variant-numeric: tabular-nums; color: var(--fg); text-decoration: none;
  }
  .s small { font-family: var(--mono); font-weight: 400; font-size: 11px; color: var(--dim); letter-spacing: 0; margin-left: 2px; }
  li.top .s { color: var(--star); }
  .s.linked { border-bottom: 1px solid currentColor; padding-bottom: 1px; }
  .s.linked::after { content: " ↗"; font-family: var(--mono); font-weight: 400; font-size: 12px; color: var(--dim); }
  .s.linked:hover { color: var(--star); }

  @media (max-width: 820px) {
    .rank { grid-template-columns: 1fr; }
    .side { position: static; }
    .list li { grid-template-columns: 26px 40px 1fr auto; gap: 12px; }
    .cov { width: 40px; height: 60px; }
  }
</style>
