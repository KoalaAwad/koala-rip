---
import { getCollection } from "astro:content";
import { rankings, years, gameInfo, coverFor, portraitFor, sentiment, critic } from "../lib/data";

// An entry gets a "review" link when it has an explicit `review` URL or a published review exists for that game.
const reviews = await getCollection("reviews", ({ data }) => !data.draft);
const reviewUrl = (title: string, explicit: string | null) => {
  if (explicit) return explicit;
  const r = reviews.find((r) => r.data.game === title);
  return r ? `/reviews/${r.id}/` : null;
};
const first = rankings[years[0]][0];
---
<section class="rank" id="ranked">
  <aside class="cover" aria-hidden="true">
    <div class="frame">
      <img class="pic on" src={portraitFor(first.title) ?? ""} alt="" />
      <img class="pic" alt="" />
    </div>
    <p class="caption">{first.title}</p>
  </aside>

  <div class="main">
    <h2 class="giant" data-reveal>Ranked</h2>
    <p class="note">Everything I played through each year (irrelevant to release date).</p>

    <div class="years">
      {years.map((y, i) => (
        <details open={i === 0}>
          <summary><span>{y}</span><span class="count">{rankings[y].length} games <span class="plus" aria-hidden="true"></span></span></summary>
          <ol>
            {rankings[y].map((e) => {
              const g = gameInfo(e.title);
              const c = critic(g);
              const steam = g.appid && g.reviewDesc ? g.reviewDesc : null;
              const href = reviewUrl(e.title, e.review);
              const thumb = coverFor(e.title);
              return (
                <li class:list={[{ top: e.score === 10, current: i === 0 && e === rankings[y][0] }]} data-cover={portraitFor(e.title) ?? undefined} data-title={e.title}>
                  {thumb && <img class="thumb" src={thumb} alt="" loading="lazy" width="40" height="60" />}
                  <span class="info">
                    <span class="name">{e.title}</span>
                    {(steam || c) && (
                      <span class="sub">
                        {steam && <span class:list={["steam", sentiment(steam)]}>{steam}</span>}
                        {c && <span class="critic">{c.source} <b>{c.score}</b></span>}
                      </span>
                    )}
                  </span>
                  <span class="right">
                    {href && <a class="rv" href={href}>review</a>}
                    <span class="s">{e.score}<small>/10</small></span>
                  </span>
                </li>
              );
            })}
          </ol>
        </details>
      ))}
    </div>
  </div>
</section>

<script>
  // The side cover follows the game you hover, or the one passing the middle of the screen.
  const cover = document.querySelector<HTMLElement>(".rank .cover");
  if (cover && matchMedia("(min-width: 821px)").matches) {
    const pics = cover.querySelectorAll<HTMLImageElement>(".pic");
    const caption = cover.querySelector<HTMLElement>(".caption")!;
    let front = 0;
    let current = pics[0].getAttribute("src") ?? "";
    // Highlight the row whose cover is on display.
    let active = document.querySelector<HTMLElement>(".rank li.current");
    const mark = (li?: HTMLElement) => {
      if (!li || li === active) return;
      active?.classList.remove("current");
      li.classList.add("current");
      active = li;
    };
    const show = (src?: string, title?: string, li?: HTMLElement) => {
      mark(li);
      if (!src || src === current) return;
      current = src;
      const img = new Image();
      img.onload = () => {
        if (current !== src) return;
        const next = pics[1 - front];
        next.src = src;
        next.classList.add("on");
        pics[front].classList.remove("on");
        front = 1 - front;
        caption.textContent = title ?? "";
      };
      img.src = src;
    };
    const rows = document.querySelectorAll<HTMLElement>(".rank li[data-cover]");
    rows.forEach((li) => li.addEventListener("mouseenter", () => show(li.dataset.cover, li.dataset.title, li)));
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        const li = e.target as HTMLElement;
        if (e.isIntersecting && li.offsetParent) show(li.dataset.cover, li.dataset.title, li);
      }),
      { rootMargin: "-48% 0px -48% 0px" },
    );
    rows.forEach((li) => io.observe(li));
  }
</script>

<style>
  .rank { display: grid; grid-template-columns: minmax(220px, 300px) 1fr; gap: 48px; border-top: 1px solid var(--line); padding-top: 32px; align-items: start; }

  /* Side cover: a true 2:3 frame, so Steam/PlayStation covers are shown whole */
  .cover { position: sticky; top: 24px; display: grid; gap: 10px; }
  .frame { position: relative; aspect-ratio: 2 / 3; background: var(--bg-raise); overflow: hidden; }
  .pic { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity .5s var(--ease-out); }
  .pic.on { opacity: 1; }
  .caption { margin: 0; color: var(--dim); font-size: 12px; }

  .main { min-width: 0; container-type: inline-size; }
  .giant { margin: 0; font-family: var(--display); font-weight: 800; font-size: 26cqw; line-height: .8; letter-spacing: -.04em; }
  .note { margin: 16px 0 24px; color: var(--dim); font-size: 13px; }

  .years { display: grid; gap: 6px; }
  details { background: var(--bg-raise); }
  summary {
    list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center;
    min-height: 56px; padding: 0 18px; font-family: var(--display); font-weight: 800; font-size: 20px;
    transition: background .2s;
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover { background: var(--bg-raise-2); }
  .count { display: inline-flex; align-items: center; gap: 14px; font-family: var(--mono); font-weight: 400; font-size: 12px; color: var(--dim); }
  .plus { position: relative; width: 12px; height: 12px; }
  .plus::before, .plus::after { content: ""; position: absolute; background: currentColor; transition: transform .25s var(--ease-out); }
  .plus::before { left: 0; right: 0; top: 5px; height: 2px; }
  .plus::after { top: 0; bottom: 0; left: 5px; width: 2px; }
  details[open] .plus::after { transform: scaleY(0); }
  details:not([open]) > ol { display: none; }

  ol { margin: 0; padding: 4px 18px 14px 46px; position: relative; z-index: 0; }
  li { display: grid; grid-template-columns: 1fr auto; gap: 16px; align-items: center; padding: 12px 0; border-bottom: 1px solid var(--line); }
  li:last-child { border-bottom: 0; }
  li { position: relative; transition: color .2s; }
  /* The row whose cover is showing beside the list */
  li::before { content: ""; position: absolute; inset: 0 -18px 0 -46px; z-index: -1; background: var(--bg-raise-2); border-left: 3px solid var(--star); opacity: 0; transition: opacity .25s; }
  li.current::before { opacity: 1; }
  li.current .name { color: var(--star); }
  li::marker { color: var(--dim); font-family: var(--display); font-variant-numeric: tabular-nums; }
  .thumb { display: none; }
  .info { display: grid; gap: 4px; min-width: 0; }
  .name { font-family: var(--display); font-weight: 500; font-size: clamp(18px, 1.8vw, 22px); letter-spacing: -.01em; line-height: 1.15; color: var(--fg); }
  .sub { display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: 12px; color: var(--dim); }
  .critic { border: 1px solid var(--line); padding: 0 5px; border-radius: 2px; font-variant-numeric: tabular-nums; }
  .critic b { color: var(--fg); font-weight: 500; }

  .right { display: flex; align-items: baseline; gap: 14px; }
  .rv { font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--fg); text-decoration: underline; text-underline-offset: 3px; transition: color .2s; }
  .rv:hover { color: var(--star); }
  .s { font-family: var(--display); font-weight: 800; font-size: 22px; letter-spacing: -.02em; min-width: 56px; text-align: right; font-variant-numeric: tabular-nums; }
  .s small { font-family: var(--mono); font-weight: 400; font-size: 11px; color: var(--dim); letter-spacing: 0; margin-left: 2px; }
  li.top .s { color: var(--star); }

  @media (max-width: 820px) {
    .rank { grid-template-columns: 1fr; }
    .cover { display: none; }
    li.current::before { opacity: 0; }
    li.current .name { color: var(--fg); }
    ol { padding-left: 34px; padding-right: 12px; }
    li { grid-template-columns: 40px 1fr auto; gap: 12px; }
    .thumb { display: block; width: 40px; height: 60px; object-fit: cover; }
  }
</style>
