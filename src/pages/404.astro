---
import Base from "../layouts/Base.astro";
---
<Base title="404 · Awad">
  <section class="nf">
    <span class="label">Error 404</span>
    <h1 class="section-title">You clipped out of bounds.</h1>
    <p>This page doesn't exist. <a href="/">Respawn at the homepage</a>.</p>
  </section>
</Base>

<style>
  .nf { display: grid; gap: 16px; padding-block: 12vh; }
  .nf h1 { font-size: clamp(40px, 8vw, 110px); max-width: 12ch; }
  .nf p { margin: 0; color: var(--dim); }
  .nf a { color: var(--star); }
</style>
