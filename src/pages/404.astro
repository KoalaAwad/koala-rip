---
import Base from "../layouts/Base.astro";
import SiteNav from "../components/SiteNav.astro";
---
<Base title="Not found · koala.rip">
  <div class="page">
    <SiteNav />
    <main class="nf">
      <h1 class="head">You clipped out of bounds.</h1>
      <p class="lead">This page doesn't exist. <a href="/">Respawn at the homepage</a>.</p>
    </main>
  </div>
</Base>

<style>
  .page { min-height: 100svh; padding: 24px max(var(--margin), env(safe-area-inset-right, 0px)) 48px max(var(--margin), env(safe-area-inset-left, 0px)); display: grid; grid-template-rows: auto 1fr; }
  .nf { align-self: center; display: grid; gap: 24px; max-width: 18ch; }
  .nf .lead { max-width: 40ch; }
  .nf a { text-underline-offset: 4px; }
</style>
