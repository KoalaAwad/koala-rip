---
import Base from "../layouts/Base.astro";
import PlatformWindow from "../components/PlatformWindow.astro";
import CompletionBadge from "../components/CompletionBadge.astro";
import { profile, steamProgress, psnProgress, finishedGames } from "../lib/data";

const steam = steamProgress();
const psn = psnProgress();
const finished = finishedGames();
---
<Base title="Achievements · Awad">
  <h1 class="section-title big">Achievements</h1>

  {finished.length > 0 && (
    <section class="done" data-reveal>
      <h2 class="section-title">Completed</h2>
      <ol>
        {finished.map((f) => (
          <li>
            <figure>
              <span class="art art-slot">
                {f.cover && <img src={f.cover} alt={f.title} width="600" height="900" loading="lazy" decoding="async" onerror="this.remove()" />}
                <span class="corner"><CompletionBadge platform={f.platform} /></span>
              </span>
              <figcaption>{f.title}</figcaption>
            </figure>
          </li>
        ))}
      </ol>
    </section>
  )}

  <div class="windows">
    <PlatformWindow platform="psn" title="PlayStation" idLabel={`PSN ID: ${profile.psnId}`} rows={psn} completeWord="platinum" emptyText="No PlayStation trophies synced yet." />
    <PlatformWindow platform="steam" title="Steam" profileUrl={profile.links.steam} rows={steam} completeWord="100%" emptyText="No Steam achievements synced yet." />
  </div>
</Base>

<style>
  .big { font-size: clamp(40px, 6vw, 80px); }
  .done { display: grid; gap: 24px; }
  .done ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 28px 18px; }
  .done li { align-self: start; }
  figure { margin: 0; display: grid; gap: 10px; }
  .art { position: relative; display: block; aspect-ratio: 2 / 3; }
  .art img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s var(--ease-out); }
  figure:hover .art img { transform: translateY(-4px); }
  .corner { position: absolute; top: -10px; right: -10px; }
  figcaption { font-family: var(--display); font-weight: 500; font-size: 15px; line-height: 1.2; }
  .windows { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; align-items: start; }
  @media (max-width: 960px) { .windows { grid-template-columns: 1fr; } }
  @media (max-width: 480px) { .done ol { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
