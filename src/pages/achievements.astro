---
import Base from "../layouts/Base.astro";
import PlatformWindow from "../components/PlatformWindow.astro";
import { profile, steamProgress, psnProgress } from "../lib/data";

const steam = steamProgress();
const psn = psnProgress();
---
<Base title="Achievements — Awad">
  <header class="head" data-reveal>
    <h1 class="section-title">Achievements</h1>
    <p>Games I've put real time into. Platinums and 100% completions sit at the top.</p>
  </header>

  <div class="windows">
    <PlatformWindow
      platform="psn"
      title="PlayStation"
      profileUrl={profile.links.psn}
      rows={psn}
      completeLabel="Platinum"
      emptyText="PlayStation trophies will show up here once the PSN sync is set up."
    />
    <PlatformWindow
      platform="steam"
      title="Steam"
      profileUrl={profile.links.steam}
      rows={steam}
      completeLabel="100%"
      emptyText="No Steam achievements synced yet."
    />
  </div>
</Base>

<style>
  .head { display: grid; gap: 10px; }
  .head h1 { font-size: clamp(48px, 8vw, 110px); }
  .head p { margin: 0; color: var(--dim); max-width: 60ch; }
  .windows { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; align-items: start; }
  @media (max-width: 960px) { .windows { grid-template-columns: 1fr; } }
</style>
