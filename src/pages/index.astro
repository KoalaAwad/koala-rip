---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Stats from "../components/Stats.astro";
import Rankings from "../components/Rankings.astro";
import { wideFor, fmtDate } from "../lib/data";

// Latest reviews only appear once something has been published.
const latest = (await getCollection("reviews", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---
<Base>
  <Hero />
  <Stats />
  <Rankings />

  {latest.length > 0 && (
    <section class="reviews" data-reveal>
      <header><h2 class="section-title">Latest reviews</h2><a href="/reviews/">All reviews</a></header>
      <div class="cards">
        {latest.map((r) => (
          <a class="card" href={`/reviews/${r.id}/`}>
            <span class="thumb">{wideFor(r.data.game) && <img src={wideFor(r.data.game)} alt="" loading="lazy" />}<span class="score">{r.data.score}</span></span>
            <span class="label">{fmtDate(r.data.date)}</span>
            <span class="name">{r.data.game}</span>
            <span class="excerpt">{r.data.excerpt}</span>
          </a>
        ))}
      </div>
    </section>
  )}
</Base>

<style>
  .reviews { display: grid; gap: 16px; }
  .reviews header { display: flex; justify-content: space-between; align-items: baseline; border-top: 1px solid var(--line); padding-top: 24px; }
  .reviews header a { color: var(--dim); font-size: 12px; text-transform: uppercase; letter-spacing: .08em; }
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .card { display: grid; gap: 8px; text-decoration: none; min-width: 0; }
  .thumb { position: relative; aspect-ratio: 2.39 / 1; overflow: hidden; background: var(--bg-raise); }
  .thumb img { width: 100%; height: 100%; object-fit: cover; opacity: .75; transition: transform 1s var(--ease-out), opacity .4s; }
  .card:hover .thumb img { transform: scale(1.05); opacity: .95; }
  .score { position: absolute; right: 10px; bottom: 8px; font-family: var(--display); font-weight: 800; font-size: 28px; }
  .name { font-family: var(--display); font-weight: 500; font-size: 19px; }
  .excerpt { color: var(--dim); font-size: 12px; }
  @media (max-width: 820px) { .cards { grid-template-columns: 1fr; } }
</style>
