---
// /reviews/ and /reviews/<game>/ — only generated once at least one review is published.
import { getCollection, render, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import { gameInfo, wideFor, sentiment, critic, fmtDate } from "../../lib/data";

export async function getStaticPaths() {
  const reviews = (await getCollection("reviews", ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  if (!reviews.length) return [];
  return [
    { params: { slug: undefined }, props: { list: reviews, review: null } },
    ...reviews.map((review) => ({ params: { slug: review.id }, props: { list: null, review } })),
  ];
}

const { list, review } = Astro.props as { list: CollectionEntry<"reviews">[] | null; review: CollectionEntry<"reviews"> | null };
const Content = review ? (await render(review)).Content : null;
const g = review ? gameInfo(review.data.game) : null;
const c = g ? critic(g) : null;
---
{list && (
  <Base title="Reviews · Awad">
    <h1 class="section-title big">Reviews</h1>
    <ol class="list">
      {list.map((r) => (
        <li>
          <a href={`/reviews/${r.id}/`}>
            <span class="pic">{wideFor(r.data.game) && <img src={wideFor(r.data.game)} alt="" loading="lazy" />}</span>
            <span class="text">
              <span class="name">{r.data.game}</span>
              <span>{r.data.excerpt}</span>
              <span class="label">{fmtDate(r.data.date)} · {r.data.score}/10</span>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </Base>
)}

{review && Content && g && (
  <Base title={`${review.data.game} review · Awad`} description={review.data.excerpt}>
    <article>
      <header class="banner">
        {wideFor(review.data.game) && <img src={wideFor(review.data.game)} alt="" />}
        <div class="t">
          <span class="label">Review · {fmtDate(review.data.date)}</span>
          <h1>{review.data.game}</h1>
        </div>
      </header>
      <div class="body">
        <aside class="facts">
          <div><span class="label">My score</span><span class="score">{review.data.score}<small>/10</small></span></div>
          {/* Only shown when the data exists: no Steam rating for non-Steam games, no critic score when none is known. */}
          {g.reviewDesc && <div><span class="label">Steam users</span><span class:list={["steam", sentiment(g.reviewDesc)]}>{g.reviewDesc}</span></div>}
          {c && <div><span class="label">{c.source}</span><span>{c.score}</span></div>}
        </aside>
        <div class="prose"><Content /></div>
      </div>
    </article>
  </Base>
)}

<style>
  .big { font-size: clamp(40px, 6vw, 80px); }
  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: 40px; }
  .list a { display: grid; grid-template-columns: 7fr 5fr; gap: 28px; align-items: center; text-decoration: none; }
  .pic { aspect-ratio: 2.39 / 1; overflow: hidden; background: var(--bg-raise); }
  .pic img { width: 100%; height: 100%; object-fit: cover; }
  .text { display: grid; gap: 8px; }
  .name { font-family: var(--display); font-weight: 800; font-size: 28px; letter-spacing: -.02em; }

  .banner { position: relative; aspect-ratio: 2.39 / 1; overflow: hidden; background: var(--bg-raise); }
  .banner img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: .55; }
  .banner .t { position: absolute; left: clamp(16px, 3vw, 32px); right: clamp(16px, 3vw, 32px); bottom: 24px; display: grid; gap: 10px; }
  .banner h1 { margin: 0; font-family: var(--display); font-weight: 800; font-size: clamp(36px, 7vw, 92px); line-height: .88; letter-spacing: -.045em; }
  .body { display: grid; grid-template-columns: 1fr 2fr; gap: 32px; margin-top: 40px; }
  .facts { display: grid; gap: 16px; align-content: start; }
  .facts div { display: grid; gap: 2px; border-top: 1px solid var(--line-strong); padding-top: 8px; font-size: 14px; }
  .score { font-family: var(--display); font-weight: 800; font-size: 48px; line-height: 1; color: var(--star); }
  .score small { font-family: var(--mono); font-size: 13px; color: var(--dim); }
  .prose { font-family: var(--display); font-weight: 300; font-size: 19px; line-height: 1.6; max-width: 65ch; }
  @media (max-width: 820px) {
    .list a, .body { grid-template-columns: 1fr; }
    .banner { aspect-ratio: 4 / 5; }
  }
</style>
