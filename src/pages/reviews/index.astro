---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import SiteNav from "../../components/SiteNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { wideFor, gameInfo, fmtDate } from "../../lib/data";

const all = (await getCollection("reviews", ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const [first, ...rest] = all;
---
<Base title="Reviews · koala.rip" description="Games I've written about, with my score out of ten.">
  <div class="page">
    <SiteNav />
    <div data-enter><h1 class="title" data-part>Reviews</h1></div>

    {first ? (
      <>
        <a class="feature" href={`/reviews/${first.id}/`} data-enter>
          <span class="pic" data-part>{wideFor(first.data.game) && <img src={wideFor(first.data.game)} alt={first.data.game} width="1920" height="620" />}</span>
          <span class="text">
            <span class="head name" data-part>{first.data.game}</span>
            <span class="lead" data-part>{first.data.excerpt}</span>
            <span data-part>{fmtDate(first.data.date)}, my score {first.data.score}/10</span>
          </span>
        </a>

        {rest.length > 0 && (
          <ol class="list">
            {rest.map((r) => {
              const shots = (gameInfo(r.data.game).screens ?? []).slice(0, 2);
              return (
                <li data-enter>
                  <a href={`/reviews/${r.id}/`}>
                    <span class="pic" data-part>{wideFor(r.data.game) && <img src={wideFor(r.data.game)} alt={r.data.game} loading="lazy" width="1920" height="620" />}</span>
                    <span class="text">
                      <span class="lead name" data-part>{r.data.game}</span>
                      <span data-part>{r.data.excerpt}</span>
                      <span data-part>{fmtDate(r.data.date)}, my score {r.data.score}/10</span>
                      {shots.length > 0 && (
                        <span class="shots">{shots.map((s) => <img data-part src={s} alt={`${r.data.game} screenshot`} loading="lazy" width="600" height="338" />)}</span>
                      )}
                    </span>
                  </a>
                </li>
              );
            })}
          </ol>
        )}
      </>
    ) : (
      <p>No written reviews yet.</p>
    )}
  </div>
  <SiteFooter />
</Base>

<style>
  .page { padding: 24px max(var(--margin), env(safe-area-inset-right, 0px)) 160px max(var(--margin), env(safe-area-inset-left, 0px)); display: grid; gap: clamp(64px, 10vh, 120px); }
  .title { font-size: clamp(3.5rem, 11.5vw, 12.5rem); font-weight: 500; letter-spacing: -0.04em; line-height: .85; margin-top: 24px; }
  a { text-decoration: none; }
  .pic { display: block; overflow: hidden; background: var(--surface); }
  .pic img { width: 100%; height: 100%; object-fit: cover; transition: transform .8s var(--ease-out); }
  a:hover .pic img, a:focus-visible .pic img { transform: scale(1.03); }
  .name { font-weight: 600; }
  a:hover .name { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 6px; }

  .feature { display: grid; gap: 24px; }
  .feature .pic { aspect-ratio: 21 / 9; }
  .feature .text { display: grid; gap: 12px; max-width: 46ch; }

  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: 96px; }
  .list a { display: grid; grid-template-columns: 7fr 5fr; gap: 32px; align-items: start; }
  .list .pic { aspect-ratio: 16 / 9; }
  .list .text { display: grid; gap: 12px; max-width: 46ch; }
  .shots { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 12px; }
  .shots img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  @media (max-width: 760px) { .list a { grid-template-columns: 1fr; gap: 16px; } }
</style>
