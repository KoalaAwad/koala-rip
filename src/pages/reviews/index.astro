---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import ReviewCard from "../../components/ReviewCard.astro";

const all = (await getCollection("reviews", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Reviews — Awad">
  <header class="head" data-reveal>
    <h1 class="section-title">Reviews</h1>
    <p class="label">{all.length} {all.length === 1 ? "review" : "reviews"}</p>
  </header>
  {all.length > 0
    ? <div class="cards">{all.map((r) => <ReviewCard review={r} />)}</div>
    : <p class="empty">No written reviews yet.</p>}
</Base>

<style>
  .head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; }
  .head h1 { font-size: clamp(48px, 8vw, 110px); }
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px 20px; }
  .empty { color: var(--dim); }
  @media (max-width: 820px) { .cards { grid-template-columns: 1fr; } }
</style>
