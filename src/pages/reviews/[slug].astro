---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { gameInfo, heroArtFor, sentiment, critic, fmtDate } from "../../lib/data";

export async function getStaticPaths() {
  const reviews = await getCollection("reviews", ({ data }) => !data.draft);
  return reviews.map((review) => ({ params: { slug: review.id }, props: { review } }));
}

const { review } = Astro.props;
const { Content } = await render(review);
const { game, score, date } = review.data;
const g = gameInfo(game);
const art = heroArtFor(game);
const c = critic(g);
---
<Base title={`${game} review — Awad`} description={review.data.excerpt}>
  <article>
    <header class="banner">
      {art && <img src={art} alt="" />}
      <div class="bars" aria-hidden="true"></div>
      <div class="t">
        <span class="label">Review · {fmtDate(date)}</span>
        <h1>{game}</h1>
      </div>
    </header>

    <div class="body">
      <aside class="facts">
        <div><span class="label">My score</span><span class="score">{score}<small>/10</small></span></div>
        {g.reviewDesc && <div><span class="label">Steam users</span><span class:list={["steam", sentiment(g.reviewDesc)]}>{g.reviewDesc}</span></div>}
        {c && <div><span class="label">{c.source}</span><span>{c.score}</span></div>}
      </aside>
      <div class="prose"><Content /></div>
    </div>
  </article>
</Base>

<style>
  .banner { position: relative; aspect-ratio: 2.39 / 1; overflow: hidden; background: linear-gradient(160deg, #1b2148, var(--bg) 72%); }
  .banner img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: .55; }
  .bars::before, .bars::after { content: ""; position: absolute; left: 0; right: 0; height: 9%; background: #000; }
  .bars::before { top: 0; } .bars::after { bottom: 0; }
  .t { position: absolute; left: clamp(16px, 3vw, 32px); right: clamp(16px, 3vw, 32px); bottom: calc(9% + 20px); display: grid; gap: 10px; }
  h1 { margin: 0; font-family: var(--display); font-weight: 800; font-size: clamp(36px, 7vw, 100px); line-height: .88; letter-spacing: -.045em; text-wrap: balance; }
  .body { display: grid; grid-template-columns: 1fr 2fr; gap: 32px; margin-top: 40px; }
  .facts { display: grid; gap: 16px; align-content: start; }
  .facts div { display: grid; gap: 2px; border-top: 1px solid var(--line-strong); padding-top: 8px; font-size: 14px; }
  .score { font-family: var(--display); font-weight: 800; font-size: 48px; line-height: 1; color: var(--star); }
  .score small { font-family: var(--mono); font-weight: 400; font-size: 13px; color: var(--dim); }
  .prose { font-family: var(--display); font-weight: 300; font-size: 19px; line-height: 1.6; max-width: 65ch; }
  .prose :global(h2) { font-weight: 800; letter-spacing: -.02em; font-size: 28px; line-height: 1.1; margin: 1.6em 0 .4em; }
  .prose :global(strong) { font-weight: 500; }
  .prose :global(a) { color: var(--star); }
  @media (max-width: 820px) {
    .banner { aspect-ratio: 4 / 5; }
    .body { grid-template-columns: 1fr; }
  }
</style>
